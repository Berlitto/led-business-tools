# Скопируй этот файл в .env и заполни реальными значениями.
# .env НЕ должен попадать в git (добавь его в .gitignore).

# Ключ Claude API. Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Пути к файлам Gmail OAuth (получить в Google Cloud Console -> APIs & Services
# -> Credentials -> OAuth client ID -> Desktop app -> Download JSON)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Название ярлыка Gmail, которым бот помечает уже обработанные письма
GMAIL_PROCESSED_LABEL=AI-Handled

# Интервал опроса почты, секунды
POLL_INTERVAL_SECONDS=60

# Файл для лога всех диалогов (JSON Lines)
CONVERSATIONS_LOG_PATH=conversations.log.jsonl

# Название компании, от имени которой отвечает бот
COMPANY_NAME=YOUR_COMPANY_NAME_HERE
